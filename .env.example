# Copy to .env and fill the endpoint and key. main.py loads .env without overriding shell values.
# Set your provider's /v1 URL and enable external generation together when using a remote API.
OPENAI_BASE_URL=
OPENAI_API_KEY=

OBSI_LLM_URL=${OPENAI_BASE_URL}
OBSI_LLM_API_KEY=${OPENAI_API_KEY}
OBSI_LLM_MODEL=gpt-5.6-luna
# 1 allows sending the question and retrieved evidence to the configured API.
OBSI_ALLOW_EXTERNAL_GENERATION=0
# Separate opt-in: send a bounded note sample to generate suggested questions automatically.
OBSI_ALLOW_EXTERNAL_SUGGESTIONS=0
